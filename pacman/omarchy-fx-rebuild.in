#!/bin/bash
# Rebuild omarchy-fx after a Hyprland update.
#
# Generated from pacman/omarchy-fx-rebuild.in by omarchy-fx's install.sh, which
# fills in the four values at the @CONFIG@ marker (shell-quoted), and driven
# by the PostTransaction hook in /etc/pacman.d/hooks/95-omarchy-fx-rebuild.hook.
# Do not edit in place — a reinstall overwrites it.
#
# This runs as root, because pacman hooks do. Root does three things here and
# no more: checks that the checkout exists, hands off to the user, and reports.
# Everything that touches the user's files — the build, the install of the .so,
# and disarming a stale one — runs as the user, with a minimal environment.
#
# Why this exists: Hyprland's plugin ABI is not stable. A plugin built against
# the old headers faults inside pluginInit when the new Hyprland tries to load
# it, and because the Hyprland config loads plugins during compositor startup,
# that fault kills the session *before* a login can complete. The only way back
# in is a TTY. Rebuilding here keeps the .so and the compositor in step.
#
# Two rules follow from that, and both matter more than the effect itself:
#   - never fail the pacman transaction; warn instead
#   - if the rebuild fails, disarm the stale .so rather than leave it loadable
set -uo pipefail
export PATH=/usr/local/bin:/usr/bin:/bin

# @CONFIG@

log() { printf 'omarchy-fx: %s\n' "$*" >&2; }

# Everything below root's own three lines runs as the user: a hook's
# environment is not a login shell's, so the environment is built from
# scratch rather than inherited, and absolute paths throughout.
as_user() {
  /usr/bin/runuser -u "$RUN_AS" -- /usr/bin/env -i \
    PATH=/usr/local/bin:/usr/bin:/bin HOME="$RUN_HOME" USER="$RUN_AS" LOGNAME="$RUN_AS" LANG=C.UTF-8 \
    "$@"
}

# Park the stale binary so the next login cannot try to load it. Wobbly windows
# are worth a great deal less than a session that comes up. The user's file,
# moved by the user: `mv` renames the name, so a link at it is moved, not
# followed.
disarm() {
  as_user /bin/bash -c '[[ -e "$1" ]] || exit 0; mv -f -- "$1" "$1.stale"' _ "$PLUGIN_SO"
  if [[ $? -eq 0 ]]; then
    log "moved the stale plugin to $(basename -- "$PLUGIN_SO").stale so it cannot"
    log "break your next login. Rebuild it with '$REPO/install.sh'."
  else
    log "COULD NOT move the stale plugin aside. Before rebooting, either run"
    log "'$REPO/install.sh' or delete $PLUGIN_SO by hand."
  fi
}

if [[ ! -d "$REPO" ]]; then
  log "the checkout at $REPO is gone, so there is nothing to rebuild from."
  disarm
  exit 0
fi

# The failure mode for a silently skipped rebuild is an unbootable session, so
# this is loud either way.
if as_user "$REPO/install.sh" --plugin-only; then
  log "rebuilt against the new Hyprland."
else
  log "REBUILD FAILED."
  disarm
fi

exit 0
